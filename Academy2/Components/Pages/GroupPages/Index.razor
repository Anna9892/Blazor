@page "/groups"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy2.Models

@inject IDbContextFactory<Academy2Context> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<div class="controls">

<h1>Группы</h1>

<p>
    <a href="groups/create" class="btn btn-primary">Добавить</a>
</p>
</div>

<div class="mb-3">
    <input type="text"
           class="form-control w-25"
           placeholder="Поиск по группам или направлениям..."
           @bind="searchString"
           @bind:event="oninput"/>
</div>


<QuickGrid Class="table" Items="FilteredGroups" Pagination="pagination">


    <PropertyColumn Property="group => group.group_name" Sortable="true" Title="Название группы" />
    <PropertyColumn Property="group => group.Direction.direction_name" Sortable="true" Title="Направление" />
    <PropertyColumn Property="group => new Week((int)(group.learning_days ?? 0))" />
    <PropertyColumn Property="group => group.start_time" />
    <PropertyColumn Property="group => group.start_date" />

    <TemplateColumn Context="group">
        
        <a href="@($"groups/details?group_id={group.group_id}")">Details</a>
   
    </TemplateColumn>
</QuickGrid>
<Paginator State="pagination" />



@code {
    
    private string searchString = string.Empty;

    
    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    
    private IQueryable<Group> FilteredGroups
    {
        get
        {
            
            var db = DbFactory.CreateDbContext();

            
            var result = db.Groups.Include(g => g.Direction).AsNoTracking();

      
            if (!string.IsNullOrWhiteSpace(searchString))
            {
                result = result.Where(g => g.group_name.Contains(searchString)
                                        || (g.Direction != null && g.Direction.direction_name.Contains(searchString)));
            }

            return result;
        }
    }
}
