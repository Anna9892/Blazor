@page "/Dec2Hex"
@rendermode InteractiveServer

<h3>Dec2Hex (Десятичное в шестнадцатеричное)</h3>

<div>
    <label>Десятичное число для перевода</label>
    <input type="number" @bind="decimalNumber" />
    <button @onclick="Calculate">Перевести</button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div>@errorMessage</div>
}
else
{
    <div>Результат: @decimalNumber = @result</div>
}

@code {
    private long decimalNumber = 0;
    private string result = "0";
    private string errorMessage = "";

    private void Calculate()
    {
        errorMessage = "";

        if (decimalNumber < 0)
        {
            errorMessage = "Пожалуйста, введите положительное число.";
            result = "0";
            return;
        }

        result = Convert.ToString(decimalNumber, 16).ToUpper();
    }
}
